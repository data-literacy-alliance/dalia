@prefix : <https://purl.org/ontology/modalia#> .
@prefix bf: <http://id.loc.gov/ontologies/bibframe/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ec: <https://github.com/tibonto/educor#> .
@prefix m4i: <http://w3id.org/nfdi4ing/metadata4ing#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix schema: <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://purl.org/ontology/modalia#> .

<https://purl.org/ontology/modalia#> rdf:type owl:Ontology ;
                                      owl:versionIRI <https://purl.org/ontology/modalia#1.0.0> ;
                                      dc:contributor "Dr. Abdelmoneim Amer Desouki (https://orcid.org/0000-0003-2083-1277), Technical University of Darmstadt (https://ror.org/05n911h24, https://isni.org/isni/0000000109401669)" ,
                                                     "Dr. Marc Fuhrmans (https://orcid.org/0000-0002-9826-018X), Technical University of Darmstadt (https://ror.org/05n911h24, https://isni.org/isni/0000000109401669)" ,
                                                     "Dr. Petra C. Steiner (https://orcid.org/0000-0001-8997-2620), Technical University of Darmstadt (https://ror.org/05n911h24, https://isni.org/isni/0000000109401669)" ,
                                                     "Frank Lange (https://orcid.org/0000-0002-9346-6031), RWTH Aachen University (https://ror.org/04xfq0f34, https://isni.org/isni/000000010728696X)" ;
                                      dc:creator "BMBF DALIA project" ;
                                      dc:description """MoDALIA: An Ontology for Educational Material in Research Data Management (RDM) and Data Science.
The ontology is used for making a knowledge graph as a backend to platform for teaching, personal learning, and recommendation.
The ontology is developed in OWL in Protege 5.5.0."""@en ;
                                      dc:title "MoDALIA Ontology"@en ;
                                      dcterms:abstract "The aim of DALIA project is to build a platform for learning material for Research Data Management (RDM) and Data Science. The platform is based on a knowledge graph. We introduce MoDalia, the base ontology of DALIA knowledge graph. Modalia inherits some modules from EduCOR. It includes also modelling of micro -credentials and certificates."@en ;
                                      dcterms:modified "2025-02-11" ;
                                      dcterms:publisher "ULB TUDa – University and State Library, Technical University, Darmstadt, Germany" ;
                                      rdfs:comment """MoDALIA reuses elements from the following ontologies:
- DCTERMS = Dublin Core Terms  
- OWL = Web Ontology Language  
- RDF = Resource Description Framework  
- RDFS = RDF Schema  
- SCHEMA = schema.org  
- SKOS = Simple Knowledge Organization System  
- EC = EduCOR"""@en ;
                                      rdfs:label "MoDALIA" ;
                                      owl:versionInfo "v1.0.0"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/contributor
dc:contributor rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
dc:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/abstract
dcterms:abstract rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
dcterms:modified rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
dcterms:publisher rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
<http://www.w3.org/2004/02/skos/core#altLabel> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#example
<http://www.w3.org/2004/02/skos/core#example> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
<http://www.w3.org/2004/02/skos/core#prefLabel> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#scopeNote
<http://www.w3.org/2004/02/skos/core#scopeNote> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/1999/02/22-rdf-syntax-ns#langString
rdf:langString rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#duration
xsd:duration rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://bibfra.me/vocab/relation/supportinghost
<http://bibfra.me/vocab/relation/supportinghost> rdf:type owl:ObjectProperty ;
                                                 rdfs:domain ec:EducationalResource ;
                                                 rdfs:range :Community ;
                                                 rdfs:label "supportinghost"@en ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "Associated community(ies) of the resource who are either the supporting organization/institution, or the recommender, or both. Here indicates supporting."@en .


###  http://id.loc.gov/ontologies/bibframe/agent
bf:agent rdf:type owl:ObjectProperty ;
         rdfs:domain bf:Contribution ;
         rdfs:range :Contributor ;
         rdfs:comment "Property that links a contribution to the agent (e.g., the person or organization making the contribution)."@en ,
                      "agent"@en .


###  http://id.loc.gov/ontologies/bibframe/contribution
bf:contribution rdf:type owl:ObjectProperty ;
                rdfs:domain ec:EducationalResource ;
                rdfs:range bf:Contribution ;
                rdfs:comment "Property linking an OER to its contribution (e.g., editing)."@en ;
                rdfs:label "contribution"@en .


###  http://id.loc.gov/ontologies/bibframe/role
bf:role rdf:type owl:ObjectProperty ;
        rdfs:domain bf:Contribution ;
        rdfs:range :ContributorRole ;
        rdfs:comment "Property that links a contribution to a role (e.g., contactPerson, editor)."@en ;
        rdfs:label "role"@en .


###  http://purl.org/dc/terms/language
dcterms:language rdf:type owl:ObjectProperty ;
                 rdfs:domain ec:EducationalResource ;
                 rdfs:range <http://lexvo.org/ontology#Language> ;
                 rdfs:comment "language of resource"@en .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:ObjectProperty ;
                rdfs:domain ec:EducationalResource ;
                rdfs:range :License ;
                rdfs:label "license"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "Property identifying the license of an Educational Resource"@en .


###  http://purl.org/ontology/rec/core#recommender
<http://purl.org/ontology/rec/core#recommender> rdf:type owl:ObjectProperty ;
                                                rdfs:domain ec:EducationalResource ;
                                                rdfs:range :Community ;
                                                rdfs:label "recommender"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "Associated community(ies) of the resource who are either the supporting organization/institution, or the recommender, or both.  Here indicates recommender"@en .


###  http://purl.org/spar/fabio/hasDiscipline
fabio:hasDiscipline rdf:type owl:ObjectProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( ec:EducationalResource
                                                ec:KnowledgeTopic
                                              )
                                ] ;
                    rdfs:range :Discipline ;
                    rdfs:label "hasDiscipline" .


###  https://github.com/tibonto/educor#consistsOfKnowledge
ec:consistsOfKnowledge rdf:type owl:ObjectProperty ;
                       rdfs:domain ec:LearningPath ;
                       rdfs:range ec:KnowledgeTopic ;
                       rdfs:label "consistsOfKnowledge" .


###  https://purl.org/ontology/modalia#belongsToArea
:belongsToArea rdf:type owl:ObjectProperty ;
               rdfs:domain :RDMTopic ;
               rdfs:range :RDMSubjectArea ;
               rdfs:label "belongsToArea"@en .


###  https://purl.org/ontology/modalia#belongsToCluster
:belongsToCluster rdf:type owl:ObjectProperty ;
                  rdfs:domain :RDMSubjectArea ;
                  rdfs:range :SubjectCluster ;
                  rdfs:label "belongsToCluster"@en .


###  https://purl.org/ontology/modalia#belongsToPhase
:belongsToPhase rdf:type owl:ObjectProperty ;
                rdfs:domain :RDMResource ;
                rdfs:range :DataLifeCyclePhase ;
                rdfs:isDefinedBy "defines the data life cycle phase that the resource covers"@en ;
                rdfs:label "belongsToPhase" .


###  https://purl.org/ontology/modalia#commentUserID
:commentUserID rdf:type owl:ObjectProperty ;
               rdfs:domain :UserComment ;
               rdfs:range :User ;
               rdfs:isDefinedBy "relates a user to his/her comment"@en ;
               rdfs:label "commentUserID"@en .


###  https://purl.org/ontology/modalia#commentedOER
:commentedOER rdf:type owl:ObjectProperty ;
              rdfs:domain :UserComment ;
              rdfs:range ec:EducationalResource ;
              rdfs:isDefinedBy "commentedOER"@en ,
                               "defines the OER that is commented in a user comment"@en ;
              rdfs:label "commentedOER"@en .


###  https://purl.org/ontology/modalia#covers
:covers rdf:type owl:ObjectProperty ;
        rdfs:domain ec:EducationalResource ;
        rdfs:range ec:KnowledgeTopic ;
        rdfs:isDefinedBy "Defines the topics covered in a learning resource"@en ;
        rdfs:label "covers"@en .


###  https://purl.org/ontology/modalia#coversManagementOfDataDescribing
:coversManagementOfDataDescribing rdf:type owl:ObjectProperty ;
                                  rdfs:domain :RDMResource ;
                                  rdfs:range <http://semanticscience.org/resource/SIO_000776> ;
                                  rdfs:label "coversManagementOfDataDescribing"@en .


###  https://purl.org/ontology/modalia#coversManagementOfDataKind
:coversManagementOfDataKind rdf:type owl:ObjectProperty ;
                            rdfs:domain :RDMResource ;
                            rdfs:range <http://edamontology.org/data_0006> ;
                            rdfs:comment "A property that relates a RDMResource to data kind being managed"@en ;
                            rdfs:label "coversManagementOfDataKind"@en .


###  https://purl.org/ontology/modalia#coversManagementOfDataObtainedWithMethod
:coversManagementOfDataObtainedWithMethod rdf:type owl:ObjectProperty ;
                                          rdfs:domain :RDMResource ;
                                          rdfs:range m4i:Method ;
                                          rdfs:label "coversManagementOfDataObtainedWithMethod"@en .


###  https://purl.org/ontology/modalia#coversManagementOfDataObtainedWithTool
:coversManagementOfDataObtainedWithTool rdf:type owl:ObjectProperty ;
                                        rdfs:domain :RDMResource ;
                                        rdfs:range m4i:Tool ;
                                        rdfs:label "coversManagementOfDataObtainedWithTool"@en .


###  https://purl.org/ontology/modalia#createdBy
:createdBy rdf:type owl:ObjectProperty ;
           rdfs:domain :Community ;
           rdfs:range :User ;
           rdfs:label "createdBy"@en .


###  https://purl.org/ontology/modalia#definesLearningPath
:definesLearningPath rdf:type owl:ObjectProperty ;
                     rdfs:domain :UserProfile ;
                     rdfs:range ec:LearningPath ;
                     rdfs:label "definesLearningPath" .


###  https://purl.org/ontology/modalia#educationalLevel
:educationalLevel rdf:type owl:ObjectProperty ;
                  rdfs:domain :User ;
                  rdfs:range :EducationalLevel ;
                  rdfs:label "educationalLevel"@en .


###  https://purl.org/ontology/modalia#essentialFor
:essentialFor rdf:type owl:ObjectProperty ;
              rdfs:domain :Skill ;
              rdfs:range :Job ;
              rdfs:label "essentialFor"@en .


###  https://purl.org/ontology/modalia#generateUserLogs
:generateUserLogs rdf:type owl:ObjectProperty ;
                  rdfs:domain :User ;
                  rdfs:range ec:UserLogs ;
                  rdfs:label "generateUserLogs" .


###  https://purl.org/ontology/modalia#givesProficiencyLevel
:givesProficiencyLevel rdf:type owl:ObjectProperty ;
                       rdfs:domain ec:EducationalResource ;
                       rdfs:range :Proficiency ;
                       rdfs:label "givesProficiencyLevel" .


###  https://purl.org/ontology/modalia#hasCertificate
:hasCertificate rdf:type owl:ObjectProperty ;
                rdfs:domain :UserEnrollment ;
                rdfs:range :Certificate ;
                rdfs:label "hasCertificate"@en .


###  https://purl.org/ontology/modalia#hasCompetenceType
:hasCompetenceType rdf:type owl:ObjectProperty ;
                   rdfs:domain :LearningGoalMatrixEntry ;
                   rdfs:range :CompetenceType ;
                   rdfs:label "hasCompetenceType"@en .


###  https://purl.org/ontology/modalia#hasEnrollment
:hasEnrollment rdf:type owl:ObjectProperty ;
               rdfs:domain :User ;
               rdfs:range :UserEnrollment ;
               rdfs:isDefinedBy "storing data about enrollments in micro-credentials of a user"@en ;
               rdfs:label "hasEnrollment"@en .


###  https://purl.org/ontology/modalia#hasLearningLevel
:hasLearningLevel rdf:type owl:ObjectProperty ;
                  rdfs:domain :LearningGoalMatrixEntry ;
                  rdfs:range :LearningLevel ;
                  rdfs:label "hasLearningLevel"@en .


###  https://purl.org/ontology/modalia#hasLearningObjective
:hasLearningObjective rdf:type owl:ObjectProperty ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( ec:EducationalResource
                                                  ec:LearningPath
                                                  :LearningGoalMatrixEntry
                                                )
                                  ] ;
                      rdfs:range :LearningObjective ;
                      rdfs:label "hasLearningObjective"@en .


###  https://purl.org/ontology/modalia#hasLearningResource
:hasLearningResource rdf:type owl:ObjectProperty ;
                     rdfs:domain ec:LearningPath ;
                     rdfs:range ec:EducationalResource ;
                     rdfs:label "hasLearningResource" .


###  https://purl.org/ontology/modalia#hasLearningType
:hasLearningType rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain ec:EducationalResource ;
                 rdfs:range :LearningResourceType ;
                 rdfs:label "hasLearningType" ;
                 <http://www.w3.org/2004/02/skos/core#definition> "The value is the learning type of content of a learning resource (e.g Lecture)"@en .


###  https://purl.org/ontology/modalia#hasMediaType
:hasMediaType rdf:type owl:ObjectProperty ;
              rdfs:domain ec:EducationalResource ;
              rdfs:range :MediaType ;
              rdfs:label "hasMediaType"@en .


###  https://purl.org/ontology/modalia#hasMicroCredential
:hasMicroCredential rdf:type owl:ObjectProperty ;
                    rdfs:domain :UserEnrollment ;
                    rdfs:range :MicroCredential ;
                    rdfs:label "hasMicroCredential" .


###  https://purl.org/ontology/modalia#hasOwner
:hasOwner rdf:type owl:ObjectProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :Community ;
          rdfs:range :User ;
          rdfs:isDefinedBy "defines the user who owns a specific community. There is only one owner to a specific community"@en ;
          rdfs:label "hasOwner"@en .


###  https://purl.org/ontology/modalia#hasProfile
:hasProfile rdf:type owl:ObjectProperty ;
            rdfs:domain :User ;
            rdfs:range :UserProfile ;
            rdfs:label "hasProfile" .


###  https://purl.org/ontology/modalia#hasProvider
:hasProvider rdf:type owl:ObjectProperty ;
             rdfs:domain ec:EducationalResource ;
             rdfs:range :Provider ;
             rdfs:label "hasProvider" .


###  https://purl.org/ontology/modalia#hasProviderType
:hasProviderType rdf:type owl:ObjectProperty ;
                 rdfs:domain :Provider ;
                 rdfs:range :ProviderType ;
                 rdfs:label "hasProviderType" .


###  https://purl.org/ontology/modalia#hasQuality
:hasQuality rdf:type owl:ObjectProperty ;
            rdfs:domain ec:EducationalResource ;
            rdfs:range :ContentQuality ;
            rdfs:label "hasQuality" .


###  https://purl.org/ontology/modalia#hasRating
:hasRating rdf:type owl:ObjectProperty ;
           rdfs:domain ec:EducationalResource ;
           rdfs:range :RatingIndicator ;
           rdfs:label "hasRating"@en .


###  https://purl.org/ontology/modalia#hasRole
:hasRole rdf:type owl:ObjectProperty ;
         rdfs:domain :User ;
         rdfs:range :UserRole ;
         rdfs:label "hasRole"@en .


###  https://purl.org/ontology/modalia#hasTargetGroup
:hasTargetGroup rdf:type owl:ObjectProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( ec:EducationalResource
                                            :LearningGoalMatrixEntry
                                          )
                            ] ;
                rdfs:range :TargetGroup ;
                rdfs:label "hasTargetGroup"@en .


###  https://purl.org/ontology/modalia#hasUser
:hasUser rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf owl:topObjectProperty ;
         rdfs:domain :RatingIndicator ;
         rdfs:range :User ;
         rdfs:label "hasUser"@en .


###  https://purl.org/ontology/modalia#isBasedOn
:isBasedOn rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :isRelatedTo ;
           rdfs:domain ec:EducationalResource ;
           rdfs:range ec:EducationalResource ;
           rdfs:comment "the object resource is a prerequisite"@en ;
           rdfs:label "isBasedOn"@en .


###  https://purl.org/ontology/modalia#isCoveredIn
:isCoveredIn rdf:type owl:ObjectProperty ;
             rdfs:domain :RDMTopic ;
             rdfs:range :LearningGoalMatrixEntry ;
             rdfs:label "isCoveredIn"@en .


###  https://purl.org/ontology/modalia#isDuplicateOf
:isDuplicateOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :isRelatedTo ;
               rdfs:domain ec:EducationalResource ;
               rdfs:range ec:EducationalResource ;
               rdfs:label "isDuplicateOf"@en .


###  https://purl.org/ontology/modalia#isLessProficientThan
:isLessProficientThan rdf:type owl:ObjectProperty ;
                      owl:inverseOf :isMoreProficientThan ;
                      rdf:type owl:TransitiveProperty ;
                      rdfs:domain :Proficiency ;
                      rdfs:range :Proficiency ;
                      rdfs:label "isLessProficientThan"@en .


###  https://purl.org/ontology/modalia#isMemberOf
:isMemberOf rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty ;
            rdfs:domain :User ;
            rdfs:range :Community ;
            rdfs:label "isMemberOf"@en .


###  https://purl.org/ontology/modalia#isMoreProficientThan
:isMoreProficientThan rdf:type owl:ObjectProperty ,
                               owl:TransitiveProperty ;
                      rdfs:domain :Proficiency ;
                      rdfs:range :Proficiency ;
                      rdfs:label "isMoreProficientThan"@en .


###  https://purl.org/ontology/modalia#isNewVersionOf
:isNewVersionOf rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :isRelatedTo ;
                rdf:type owl:TransitiveProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain ec:EducationalResource ;
                rdfs:range ec:EducationalResource ;
                rdfs:label "isNewVersionOf"@en .


###  https://purl.org/ontology/modalia#isPartOf
:isPartOf rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :isRelatedTo ;
          rdfs:domain ec:EducationalResource ;
          rdfs:range ec:EducationalResource ;
          rdfs:label "isPartOf"@en .


###  https://purl.org/ontology/modalia#isRelatedTo
:isRelatedTo rdf:type owl:ObjectProperty ;
             rdfs:domain ec:EducationalResource ;
             rdfs:range ec:EducationalResource ;
             rdfs:label "isRelatedTo"@en .


###  https://purl.org/ontology/modalia#isTranslationOf
:isTranslationOf rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :isRelatedTo ;
                 rdfs:domain ec:EducationalResource ;
                 rdfs:range ec:EducationalResource ;
                 rdfs:label "isTranslationOf"@en .


###  https://purl.org/ontology/modalia#nextPhase
:nextPhase rdf:type owl:ObjectProperty ;
           rdfs:domain :DataLifeCyclePhase ;
           rdfs:range :DataLifeCyclePhase ;
           rdfs:label "nextPhase"@en .


###  https://purl.org/ontology/modalia#optionalFor
:optionalFor rdf:type owl:ObjectProperty ;
             rdfs:domain :Skill ;
             rdfs:range :Job ;
             rdfs:label "optionalFor"@en .


###  https://purl.org/ontology/modalia#prerequisites
:prerequisites rdf:type owl:ObjectProperty ;
               rdfs:domain ec:KnowledgeTopic ;
               rdfs:range ec:KnowledgeTopic ;
               rdfs:label "prerequisites"@en .


###  https://purl.org/ontology/modalia#requiresKnowledge
:requiresKnowledge rdf:type owl:ObjectProperty ;
                   rdfs:domain :Skill ;
                   rdfs:range ec:KnowledgeTopic ;
                   rdfs:label "requiresKnowledge"@en .


###  https://purl.org/ontology/modalia#requiresProficiencyLevel
:requiresProficiencyLevel rdf:type owl:ObjectProperty ;
                          rdfs:domain ec:EducationalResource ;
                          rdfs:range :Proficiency ;
                          rdfs:label "requiresProficiencyLevel"@en .


###  https://purl.org/ontology/modalia#solves
:solves rdf:type owl:ObjectProperty ;
        rdfs:domain :User ;
        rdfs:range [ rdf:type owl:Class ;
                     owl:unionOf ( :Questionnaire
                                   <https://w3id.org/kim/hcrt/assessment>
                                 )
                   ] ;
        rdfs:label "solves"@en .


###  https://purl.org/ontology/modalia#storedIn
:storedIn rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( ec:LearningPreference
                                      :Certificate
                                      :LearningObjective
                                    )
                      ] ;
          rdfs:range :UserProfile ;
          rdfs:label "storedIn"@en .


###  https://purl.org/ontology/modalia#teachesSkill
:teachesSkill rdf:type owl:ObjectProperty ;
              rdfs:domain ec:EducationalResource ;
              rdfs:range :Skill ;
              rdfs:label "teaches skill"@en .


###  https://purl.org/ontology/modalia#userBookmarks
:userBookmarks rdf:type owl:ObjectProperty ;
               rdfs:domain :User ;
               rdfs:range ec:EducationalResource ;
               rdfs:label "userBookmarks"@en .


###  https://purl.org/ontology/modalia#userLikes
:userLikes rdf:type owl:ObjectProperty ;
           rdfs:domain :User ;
           rdfs:range ec:EducationalResource ;
           rdfs:label "userLikes"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "stores that user liked a given OER"@en .


###  https://purl.org/ontology/modalia#userViews
:userViews rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           rdfs:domain :User ;
           rdfs:range ec:EducationalResource ;
           rdfs:label "userViews"@en .


###  https://schema.org/author
schema:author rdf:type owl:ObjectProperty ;
              rdfs:domain ec:EducationalResource ;
              rdfs:range rdf:List ;
              rdfs:comment "Property linking an OER  to a list of authors."@en ;
              rdfs:label "author"@en .


###  https://w3id.org/citedcat-ap/isSupplementedBy
<https://w3id.org/citedcat-ap/isSupplementedBy> rdf:type owl:ObjectProperty ;
                                                rdfs:subPropertyOf :isRelatedTo ;
                                                rdfs:domain ec:EducationalResource ;
                                                rdfs:range ec:EducationalResource ;
                                                rdfs:label "isSupplementedBy"@en .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/terms/created
dcterms:created rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf owl:topDataProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( ec:EducationalResource
                                            :Community
                                          )
                            ] ;
                rdfs:range xsd:dateTime ;
                rdfs:label "Date Created"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "Date of creation of the resource."@en .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:DatatypeProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( ec:EducationalResource
                                                ec:KnowledgeTopic
                                                :Community
                                              )
                                ] ;
                    rdfs:range xsd:string ;
                    rdfs:label "description"@en .


###  http://purl.org/dc/terms/format
dcterms:format rdf:type owl:DatatypeProperty ;
               rdfs:domain ec:EducationalResource ;
               rdfs:range xsd:string ;
               rdfs:isDefinedBy "File format of the file representing the resource" ;
               rdfs:label "file format"@en ;
               <http://www.w3.org/2004/02/skos/core#example> "PDF, AVI" .


###  http://purl.org/dc/terms/issued
dcterms:issued rdf:type owl:DatatypeProperty ;
               rdfs:domain ec:EducationalResource ;
               rdfs:range xsd:dateTime ;
               rdfs:label "issued"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Date of formal issuance (e.g., publication) of the resource."@en .


###  http://purl.org/dc/terms/rights
dcterms:rights rdf:type owl:DatatypeProperty ;
               rdfs:domain ec:EducationalResource ;
               rdfs:range xsd:string ;
               rdfs:label "rights"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:DatatypeProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( ec:EducationalResource
                                          ec:KnowledgeTopic
                                          :Community
                                        )
                          ] ;
              rdfs:range xsd:string ;
              rdfs:label "title"@en .


###  http://purl.org/spar/fabio/hasSubtitle
fabio:hasSubtitle rdf:type owl:DatatypeProperty ;
                  rdfs:domain ec:EducationalResource ;
                  rdfs:range xsd:string ;
                  rdfs:label "has Subtitle"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#hasRorId
m4i:hasRorId rdf:type owl:DatatypeProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Community
                                         schema:Organization
                                       )
                         ] ;
             rdfs:range [ rdf:type rdfs:Datatype ;
                          owl:onDatatype xsd:string ;
                          owl:withRestrictions ( [ xsd:pattern "https://ror.org/[0-9][0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][0-9][0-9]"
                                                 ]
                                               )
                        ] ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "has research organization registry id"@en ,
                                                            "hat Forschungsorganisationsid"@de ;
             <http://www.w3.org/2004/02/skos/core#definition> "A Research Organization Registry identifier that persistently and uniquely identifies a research organization"@en ,
                                                              "Ein persistenter Identifikator für Organisationen, vergeben durch die Research Organization Registry, der eine Forschungseinrichtung eindeutig identifiziert."@de ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "has ROR ID"@en ,
                                                             "hat ROR ID"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#orcidId
m4i:orcidId rdf:type owl:DatatypeProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :Contributor
                                        :User
                                      )
                        ] ;
            rdfs:range [ rdf:type rdfs:Datatype ;
                         owl:onDatatype xsd:string ;
                         owl:withRestrictions ( [ xsd:pattern "https://orcid.org/[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9X]"
                                                ]
                                              )
                       ] ;
            <http://www.w3.org/2004/02/skos/core#definition> "Open Researcher and Contributor ID: an identifier, that allows unique identification of a person, usually active in research."@en ,
                                                             "Open Researcher and Contributor ID: ein persistenter Identifikator, der eine in der Forschung tätige Person eindeutig identifiziert."@de ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "has ORCID ID"@en ,
                                                            "hat ORCID ID"@de .


