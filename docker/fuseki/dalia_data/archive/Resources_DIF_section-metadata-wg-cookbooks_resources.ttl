<https://id.dalia.education/learning-resource/4374117c-1a89-424b-ae77-c15076d399f3> a ec:EducationalResource ;
    dcterms:description "While data curators, and increasingly researchers, know that good metadata is key for research data access and re-use, figuring out precisely what metadata to capture and how to capture it is a complex task. Fortunately, many academic disciplines have supported initiatives to formalise the metadata specifications the community deems to be required for data re-use. This page provides links to information about these disciplinary metadata standards, including profiles, tools to implement the standards, and use cases of data repositories currently implementing them." ;
    dcterms:format "HTML" ;
    dcterms:language <http://lexvo.org/id/iso639-3/eng> ;
    dcterms:license mo:ProprietaryLicense ;
    dcterms:title "Disciplinary Metadata | DCC" ;
    fabio:hasDiscipline <https://w3id.org/kim/hochschulfaechersystematik/n0>,
        <https://w3id.org/kim/hochschulfaechersystematik/n0128>,
        <https://w3id.org/kim/hochschulfaechersystematik/n1>,
        <https://w3id.org/kim/hochschulfaechersystematik/n26>,
        <https://w3id.org/kim/hochschulfaechersystematik/n42>,
        <https://w3id.org/kim/hochschulfaechersystematik/n43>,
        <https://w3id.org/kim/hochschulfaechersystematik/n44> ;
    ns1:authorUnordered [ a schema:Organization ;
            schema:name "DCC Digital Curation Centre" ] ;
    mo:hasLearningType bibo:Webpage ;
    mo:hasMediaType schema:Text ;
    mo:requiresProficiencyLevel mo:Novice ;
    schema:author ( [ a schema:Organization ;
                schema:name "DCC Digital Curation Centre" ] ) ;
    schema:keywords "classification scheme",
        "metadata" ;
    schema:url <https://www.dcc.ac.uk/guidance/standards/metadata> .

