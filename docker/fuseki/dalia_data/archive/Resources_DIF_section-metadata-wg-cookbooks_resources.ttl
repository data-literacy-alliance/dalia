<https://id.dalia.education/learning-resource/7b89958d-4b1b-48f2-a60a-91f3089041b9> a ec:EducationalResource ;
    bflr:supportinghost dalia-community:bead62a8-c3c2-46d6-9eb1-ffeaba38d5bf ;
    dcterms:description "Die NFDI4Chem Knowledge Base bietet Informationen und Empfehlungen für die Digitalisierung aller wichtigen Schritte in der chemischen Forschung, um Wissenschaftlerinnen und Wissenschaftler in ihren Bemühungen zu unterstützen, Forschungsdaten zu sammeln, zu speichern, zu verarbeiten, zu analysieren, offenzulegen und wiederzuverwenden. Diese Wissensdatenbank ist von RDMkit (https://rdmkit.elixir-europe.org/index.html) inspiriert, wurde aber speziell auf Chemiker als Endnutzer zugeschnitten. Maßnahmen zur Förderung von Open Science und Forschungsdatenmanagement (siehe auch https://riojournal.com/article/55852/) in Übereinstimmung mit den FAIR-Datenprinzipien werden von alltäglichen Nutzern vorgestellt und reichen von der Planung und Umsetzung bis zur Veröffentlichung und Wiederverwendung." ;
    dcterms:format "HTML" ;
    dcterms:language <http://lexvo.org/id/iso639-3/deu>,
        <http://lexvo.org/id/iso639-3/eng> ;
    dcterms:license <http://spdx.org/licenses/CC-BY-SA-4.0> ;
    dcterms:title "NFDI4Chem Knowledge Base" ;
    fabio:hasDiscipline <https://w3id.org/kim/hochschulfaechersystematik/n032>,
        <https://w3id.org/kim/hochschulfaechersystematik/n06> ;
    fabio:hasSubtitle "Ein Platz für alles Wissenswerte zum Forschungsdatenmanagement (FDM) in der Chemie" ;
    ns1:authorUnordered [ a schema:Organization ;
            owl:sameAs <http://www.wikidata.org/entity/Q96678459> ;
            schema:name "NFDI4Chem" ] ;
    mo:hasLearningType bibo:Webpage ;
    mo:hasMediaType schema:Text,
        schema:VideoObject ;
    mo:hasTargetGroup mo:Researcher ;
    mo:requiresProficiencyLevel mo:Beginner,
        mo:Competent,
        mo:Expert,
        mo:Novice,
        mo:Proficient ;
    schema:author ( [ a schema:Organization ;
                owl:sameAs <http://www.wikidata.org/entity/Q96678459> ;
                schema:name "NFDI4Chem" ] ) ;
    schema:keywords "Forschungsdatenmanagement",
        "research data management" ;
    schema:url <https://knowledgebase.nfdi4chem.de/knowledge_base/de/> .

