<https://id.dalia.education/learning-resource/84f0a93b-b978-4ca5-b823-28fd618f3f17> a ec:EducationalResource ;
    dcterms:description "The teaching and training manual is intended to support higher education institutions in integrating FAIR-specific content into curricula. It offers a comprehensive presentation of all FDM and FAIR topics, arranged by competence profiles, and includes practical material." ;
    dcterms:language <http://lexvo.org/id/iso639-3/eng> ;
    dcterms:license <http://spdx.org/licenses/CC-BY-4.0> ;
