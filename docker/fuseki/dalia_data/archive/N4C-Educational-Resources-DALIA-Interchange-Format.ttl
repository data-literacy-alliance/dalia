    schema:datePublished "2014-06-01"^^xsd:date ;
    schema:keywords "editing",
        "metadata",
        "teaching",
        "text" ;
    schema:url <https://de.dariah.eu/tei-tutorial> .

<https://id.dalia.education/learning-resource/54e213e7-ce51-46f7-b8ad-84c2965e35fb> a ec:EducationalResource ;
    dcterms:description "The \"Open Science: From Data to Publications\" online self-study course offers a clear overview of selected topics. Since the focus is on \"Open Science\", no claim is made to offer a comprehensive overview of Research Data Management. The videos and specific content from different input providers are presented in a structured and clear way." ;
