                schema:familyName "Körner" ;
                schema:givenName "Erik" ] ) ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:url <https://www.berd-nfdi.de/wp-content/uploads/2023/10/AI-text-2-Wortschatz_export.pdf> .

dalia-learning-resource:4fd550c3-43ab-4549-9c41-72e672fce34d a ec:EducationalResource ;
    dcterms:description "Following a brief introduction to Active Learning, we shall demonstrate how the Active Learning Library Small-Text can be applied to a “Words-of-the-Day”-Corpus of the Leipzig Corpora Collection. In addition we shall discuss how LLMs can be used for social science research, and how they can be optimised with respect to performance and memory requirements." ;
    dcterms:language <http://lexvo.org/id/iso639-3/eng> ;
    dcterms:license mo:ProprietaryLicense ;
    dcterms:title "Active Learning with (L)LMs: State of the Art and Practical Challenges" ;
