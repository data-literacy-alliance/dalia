dalia-learning-resource:911cf7d9-43e7-4280-982e-c3da1f4fb4da a ec:EducationalResource ;
    dcterms:description "Research data management is essential for scientific research, enabling interoperability, reproducibility and sharing of knowledge. The ARC Container, a research data container developed in DataPLANT, is built upon ISA and structures experimental (meta)data hierarchically. The corresponding ARC Container Ontology offers a graph representation of the ARC, linking all concepts and attributes together in a semantic network. This ontology facilitates additional analyses and metadata inference, based on structured experimental data. We demonstrate its use for analyzing single cell RNA sequencing data from Arabidopsis thaliana from public datasets. By querying quality scores for the data files and the experimental parameters, we investigate the relationship between raw data quality and the experimental setup. In the future, the ARC Container Ontology will be expanded to cover additional standards to ISA and applied to data types from different methodologies in order to facilitate extensive analyses for diverse data in plant sciences." ;
    dcterms:format "PDF" ;
    dcterms:language <http://lexvo.org/id/iso639-3/eng> ;
    dcterms:license <http://spdx.org/licenses/CC-BY-4.0> ;
    dcterms:title "Using Container Ontologies Built on ISA for (Meta)data Quality Analysis in Transcriptomics" ;
    ns1:authorUnordered [ a schema:Person ;
            schema:familyName "Usadel" ;
            schema:givenName "Björn" ],
        [ a schema:Person ;
            schema:familyName "Dörpholz" ;
            schema:givenName "Hannah" ],
        [ a schema:Person ;
            schema:familyName "Kranz" ;
            schema:givenName "Angela" ] ;
    mo:hasCommunity dalia-community:fa16b39f-4bc1-4f48-beaf-cbd030d5a7b4 ;
