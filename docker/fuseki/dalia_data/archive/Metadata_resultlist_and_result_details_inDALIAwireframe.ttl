        "ontology",
        "research data management" ;
    schema:url <https://zenodo.org/records/8405208> .

dalia-learning-resource:915f892f-548d-4214-bbb5-a287e4daa2e7 a ec:EducationalResource ;
    dcterms:description "\"Datendokumentation leicht gemacht! Ein interaktiver Online-Workshop\" richtet sich insbesondere an FDM-Trainer*innen und Data Stewards, aber auch Forschende sind potenzielle Teilnehmende. Mit dem eineinhalbstündigen Online-Workshop wird die Datendokumentation als lästiges aber notwendiges Thema im Forschungsdatenmanagement aufgegriffen und Lehrkonzepte umgesetzt, die die Interaktivität von Online-Veranstaltungen steigern." ;
    dcterms:format "DOCX",
