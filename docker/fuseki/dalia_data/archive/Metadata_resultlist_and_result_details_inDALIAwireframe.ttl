                schema:givenName "Joshua Allen" ] ) ;
    schema:datePublished "2023-09-13"^^xsd:date ;
    schema:fileSize "12.0 MB" ;
    schema:keywords "FAIR",
        "bioimaging",
        "cloud",
        "community",
        "data",
        "format" ;
    schema:url <https://zenodo.org/records/8340248> .

