<https://id.dalia.education/learning-resource/ef829720-0dca-453e-acdc-5e720c171517> a ec:EducationalResource ;
    bflr:supportinghost dalia-community:aac7b1be-cf00-4fdc-a26a-e8e0e1410b18 ;
    dcterms:description "This presentation at the NFDI4Biodiversity & GfÖ Winter School 2022 focused on the fundamentals of Data Management and Data Literacy in the context of biodiversity research. Attendees gained insights into best practices for data collection, storage, sharing, and preservation. Further, the presentation emphasized the vital roles of NFDI4Biodiversity and GFBio services in fostering data-driven research, supporting data curation, and promoting a culture of data literacy within the biodiversity community." ;
    dcterms:language <http://lexvo.org/id/iso639-3/eng> ;
    dcterms:license <http://spdx.org/licenses/CC-BY-4.0> ;
    dcterms:title "Data Management and Data Literacy" ;
    rec:recommender dalia-community:aac7b1be-cf00-4fdc-a26a-e8e0e1410b18 ;
