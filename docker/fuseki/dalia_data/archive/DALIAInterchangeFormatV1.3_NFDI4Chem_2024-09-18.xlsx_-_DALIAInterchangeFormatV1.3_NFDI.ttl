<https://id.dalia.education/learning-resource/13fbe24d-0c2e-46b2-b166-2f1def45b677> a ec:EducationalResource ;
    bflr:supportinghost dalia-community:bead62a8-c3c2-46d6-9eb1-ffeaba38d5bf ;
