            schema:givenName "Philip" ],
        [ a schema:Person ;
            m4i:orcidId "https://orcid.org/0009-0001-5998-5030" ;
            schema:familyName "Rayya" ;
            schema:givenName "Noura" ] ;
    mo:hasMediaType schema:PresentationDigitalDocument ;
