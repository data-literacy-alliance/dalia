<https://id.dalia.education/learning-resource/76e18c8a-30a3-4217-81db-62e6343a6892> a ec:EducationalResource ;
    bflr:supportinghost dalia-community:bead62a8-c3c2-46d6-9eb1-ffeaba38d5bf ;
    dcterms:description "Day 2 Part 2 covers reports about tools used in projects for data annotations like the application of ontologies in ELN and data repositories in NFDI4Chem, the IUPAC FairSpec project and how to integrate vocabularies into established discipline-specific ontologies. The use of ontologies for the data annotation in Pubchem and ClassyFire for automated chemical classification and applications. Recording Day 2 Part 2 of the 1st International Ontologies4Chem Workshopy organized by NFDI4Chem - the chemistry consortium in the NFDI. The workshop provided a comprehensive overview of past and current activities of chemistry ontology projects, tools for ontology engineering and the application and curation of ontogologies in research data management. Details: https://doi.org/10.25798/frnp-sn04" ;
    dcterms:language <http://lexvo.org/id/iso639-3/eng> ;
    dcterms:license mo:ProprietaryLicense ;
    dcterms:title "Ontologies4Chem workshop Day 2 Part 2 - Tools used in projects for data annotations" ;
    rec:recommender dalia-community:bead62a8-c3c2-46d6-9eb1-ffeaba38d5bf ;
    ns1:authorUnordered [ a schema:Organization ;
            owl:sameAs <http://www.wikidata.org/entity/Q96678459> ;
            schema:name "NFDI4Chem" ] ;
    mo:hasMediaType schema:VideoObject ;
    schema:author ( [ a schema:Organization ;
                owl:sameAs <http://www.wikidata.org/entity/Q96678459> ;
                schema:name "NFDI4Chem" ] ) ;
    schema:datePublished "2022-09-27"^^xsd:date ;
    schema:url <https://www.youtube.com/watch?v=Bm-4fScOdrE&list=PLlTKDYkC1Ls8wiHU-DzN1KwapxRpLkfVa&index=6> .

<https://id.dalia.education/learning-resource/7926f41a-951a-47fc-987c-e168fcca8396> a ec:EducationalResource ;
    bflr:supportinghost dalia-community:2040c8ce-b62c-4cb7-be94-85cb8eeaa0f8,
        dalia-community:3dc37495-59bb-4505-851f-e09c5df8e356,
        dalia-community:bead62a8-c3c2-46d6-9eb1-ffeaba38d5bf,
        dalia-community:f6e6a7fc-552b-4d75-9fca-8e2b1b8ad624 ;
    dcterms:description "Rich Metadata are of utmost importance to improve the Findability and Reusability of research data. In this NFDI-Infratalk, we showcase how datasets can be described with domain specific metadata using SchemaOrg as JSON-LD, using defined terms from terminology services, and how everything can be indexed in searchable resources." ;
