<https://id.dalia.education/learning-resource/7044482c-c3b5-479b-9ad4-dc64b98ff1d4> a ec:EducationalResource ;
    bflr:supportinghost dalia-community:bead62a8-c3c2-46d6-9eb1-ffeaba38d5bf ;
    dcterms:description """The domain-specific JSON-LD based metadata in Schema.org and Bioschemas.org allows to provide property values not only as free-text or URL, but also as a DefinedTerm from a DefinedTermSet. Several examples exist where e.g., terms from OBO Ontologies are used, automatic FAIR evaluators honor their use, and validators start to check that valid terms are used.
This presentation gives examples, suggests a discussion of (documented) best practices, and calls for (more) implementations.""" ;
    dcterms:format "PDF" ;
    dcterms:language <http://lexvo.org/id/iso639-3/eng> ;
    dcterms:license <http://spdx.org/licenses/CC-BY-4.0> ;
    dcterms:title "Ontologies4SchemaOrg" ;
    rec:recommender dalia-community:bead62a8-c3c2-46d6-9eb1-ffeaba38d5bf ;
