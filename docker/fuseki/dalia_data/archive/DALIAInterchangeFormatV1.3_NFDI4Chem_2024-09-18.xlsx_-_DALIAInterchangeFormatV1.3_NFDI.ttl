<https://id.dalia.education/learning-resource/206a4cee-403b-48be-bdbf-e8d9f92b5adb> a ec:EducationalResource ;
    bflr:supportinghost dalia-community:bead62a8-c3c2-46d6-9eb1-ffeaba38d5bf ;
