<https://id.dalia.education/learning-resource/4e77ec25-4fe2-4577-ac7f-50e37c5f6795> a ec:EducationalResource ;
    bflr:supportinghost dalia-community:bead62a8-c3c2-46d6-9eb1-ffeaba38d5bf ;
    dcterms:description "Nuclear magnetic resonance (NMR) allows researchers to obtain rich structural information and it's the standard method of determining the absolute chemical structure. It is also widely used in natural product dereplication, unknown identification, and metabolomics. Owing to the importance of NMR data, nmrXiv is currently being developed with the ultimate goal of accelerating broader coordination and data sharing among researchers by creating a computational platform for the management, sharing, and analysis of NMR data. nmrXiv is voluntarily FAIR, open-source, and cloud-based NMR data infrastructure." ;
    dcterms:format "PDF" ;
    dcterms:language <http://lexvo.org/id/iso639-3/eng> ;
    dcterms:license <http://spdx.org/licenses/CC-BY-4.0> ;
    dcterms:title "nmrXiv" ;
    rec:recommender dalia-community:bead62a8-c3c2-46d6-9eb1-ffeaba38d5bf ;
