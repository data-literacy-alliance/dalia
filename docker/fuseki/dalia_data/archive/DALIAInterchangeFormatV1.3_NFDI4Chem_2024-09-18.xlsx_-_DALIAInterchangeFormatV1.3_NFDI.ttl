    schema:url <https://www.youtube.com/watch?v=c-QmGjhEdIQ&list=PLlTKDYkC1Ls_Vvym6FY1hdDzA1VcPGu9i&index=7> .

<https://id.dalia.education/learning-resource/3f82bc47-3798-48b2-afd9-056b0c1bc47a> a ec:EducationalResource ;
    bflr:supportinghost dalia-community:bead62a8-c3c2-46d6-9eb1-ffeaba38d5bf ;
    dcterms:description "Wenn man sich mit Forschungsdatenmanagement beschäftigt, stolpert man öfter über den Begriff \"Ontologie\". Was ist das eigentlich und was hat das mit Chemie zu tun?" ;
    dcterms:language <http://lexvo.org/id/iso639-3/deu> ;
    dcterms:license mo:ProprietaryLicense ;
    dcterms:title "Ontologien - was ist das eigentlich?" ;
    rec:recommender dalia-community:bead62a8-c3c2-46d6-9eb1-ffeaba38d5bf ;
    ns1:authorUnordered [ a schema:Organization ;
            owl:sameAs <http://www.wikidata.org/entity/Q96678459> ;
