<https://id.dalia.education/learning-resource/3852d134-cb5a-447b-b44d-42e5deebe8a8> a ec:EducationalResource ;
    bflr:supportinghost dalia-community:2040c8ce-b62c-4cb7-be94-85cb8eeaa0f8,
        dalia-community:7c45de27-5996-40b5-8e0e-24afdfe148e5,
        dalia-community:bead62a8-c3c2-46d6-9eb1-ffeaba38d5bf,
        dalia-community:f6e6a7fc-552b-4d75-9fca-8e2b1b8ad624,
        dalia-community:fa16b39f-4bc1-4f48-beaf-cbd030d5a7b4 ;
    dcterms:description "Schema.org is a controlled vocabulary that makes it easier for web pages to describe their actual content in a semantic, structured and machine-processable way. It is recognized by major search engines and data aggregators, making it easier for researchers to expose metadata describing their research outcomes. Here we present how Schema.org is used (or planned to be used) by some NFDI consortia, becoming a lightweight approach to harmonize digital objects coming from different sources so they can be connected to each other in a meaningful way." ;
    dcterms:format "PDF" ;
    dcterms:language <http://lexvo.org/id/iso639-3/eng> ;
    dcterms:license <http://spdx.org/licenses/CC-BY-4.0> ;
    dcterms:title "Schema.org as a Lightweight Harmonization Approach for NFDI" ;
    rec:recommender dalia-community:bead62a8-c3c2-46d6-9eb1-ffeaba38d5bf ;
