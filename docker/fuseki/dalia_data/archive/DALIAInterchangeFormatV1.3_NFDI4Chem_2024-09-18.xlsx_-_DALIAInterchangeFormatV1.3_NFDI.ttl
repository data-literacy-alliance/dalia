<https://id.dalia.education/learning-resource/40a5e2e1-81e9-4fe2-9fbe-4129debd0d4b> a ec:EducationalResource ;
    bflr:supportinghost dalia-community:bead62a8-c3c2-46d6-9eb1-ffeaba38d5bf ;
    dcterms:description "Day 1 Part 2 covers reports from major chemistry ontologies including the IUPAC Gold Book - Compendium of Chemical Terminology, Chemical Entities of Biological Interest (ChEBI), the Chemical Information Ontology (CHEMINF), ontologies of the Royal Society of Chemistry: the the Molecular Process Ontology (MOP), the Named Reaction Ontology (RXNO) and the Chemical Methods Ontology (CHMO), Chemical Relations and ChEBI Integrated Role Ontology (ChIRO), Chemical Entity Materials and Reactions Ontological Framework (ChEMROF), the ontology of operations, data types, formats, identifiers and topics (EDAM) , the Ontology of Biomedical Investigations (OBI), the Semanticscience Integrated Ontology (SIO) and Bioschemas.org. The workshop provided a comprehensive overview of past and current activities of chemistry ontology projects, tools for ontology engineering and the application and curation of ontogologies in research data management. Recording Day 1 Part 2 of the 1st International Ontologies4Chem Workshopy organized by NFDI4Chem - the chemistry consortium in the NFDI. Scroll down for links to chaptes in the video Details: https://doi.org/10.25798/frnp-sn04" ;
    dcterms:language <http://lexvo.org/id/iso639-3/eng> ;
    dcterms:license mo:ProprietaryLicense ;
    dcterms:title "Ontologies4Chem Workshop Day 1 Part 2 - Chemistry Ontologies, past and current developments" ;
    rec:recommender dalia-community:bead62a8-c3c2-46d6-9eb1-ffeaba38d5bf ;
    ns1:authorUnordered [ a schema:Organization ;
            owl:sameAs <http://www.wikidata.org/entity/Q96678459> ;
            schema:name "NFDI4Chem" ] ;
