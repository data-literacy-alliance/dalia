<https://id.dalia.education/learning-resource/cbdc9f68-a112-4197-8a24-894f5a983315> a ec:EducationalResource ;
    dcterms:description "TUCAN is a canonical serialization format that is independent of domain-specific concepts of structure and bonding. The atomic number is the only chemical feature that is used to derive the TUCAN format. Other than that, the format is solely based on the molecular topology. Validation is reported on a manually curated test set of molecules as well as a library of non-chemical graphs. The serialization procedure generates a canonical “tuple-style” output which is bidirectional, allowing the TUCAN string to serve as both identifier and descriptor. Use of the Python NetworkX graph library facilitated a compact and easily extensible implementation." ;
    dcterms:format "PDF" ;
    dcterms:language <http://lexvo.org/id/iso639-3/eng> ;
    dcterms:license <http://spdx.org/licenses/CC-BY-4.0> ;
    dcterms:title "TUCAN" ;
    fabio:hasSubtitle "A molecular identifier and descriptor applicable to the whole periodic table from hydrogen to oganesson" ;
    ns1:authorUnordered [ a schema:Person ;
            schema:familyName "Hoffmann" ;
            schema:givenName "Alexander" ],
