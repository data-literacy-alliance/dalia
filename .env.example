# Django
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web,search.dalia.education

# Database (PostgreSQL in container)
POSTGRES_DB=dalia20
POSTGRES_USER=dalia20
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dalia20:changeme@db:5432/dalia20

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Application
LANGUAGE_CODE=en-us
TIME_ZONE=UTC

# Frontend URLs (used by NFDI auth adapter for redirect after login)
DEV_FRONTEND_URL=
STAGING_FRONTEND_URL=

# Superuser (created automatically on first run)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@dalia20.local
DJANGO_SUPERUSER_PASSWORD=ChangeMe123!SecurePassword

# Elasticsearch
ELASTICSEARCH_HOST=elasticsearch:9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# NFDI AAI OIDC Authentication
IAM4NFDI_CLIENT_ID=your-client-id-here
IAM4NFDI_CLIENT_SECRET=your-client-secret-here

# CORS (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:7087

# Triplestore (own Fuseki on dalia20-network)
DALIA_TRIPLESTORE_BASE_URL=http://fuseki:3030/

# Matomo Tag Manager (frontend analytics)
# Both vars must be set together. If either is empty/unset, the Matomo script is
# not injected at all — this prevents a broken relative-URL 404 in local dev.
# NEXT_PUBLIC_MATOMO_URL must include a trailing slash, e.g.:
#   https://analytics.dalia.education/
# NEXT_PUBLIC_MATOMO_CONTAINER_ID is the container ID string from your Matomo instance.
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_CONTAINER_ID=
