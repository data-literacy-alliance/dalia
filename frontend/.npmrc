# pnpm configuration for DALIA Frontend

# Disable build scripts approval requirement
# This allows sharp and other packages to run post-install scripts
# Required for Next.js Image Optimization
unsafe-perm=true

# Packages allowed to run build scripts (replaces pnpm.onlyBuiltDependencies in package.json, removed in pnpm v11)
onlyBuiltDependencies[]=sharp
onlyBuiltDependencies[]=unrs-resolver
