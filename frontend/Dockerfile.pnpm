# Optimized Next.js Dockerfile with pnpm
# Based on: https://github.com/mpash/pnpm-next-docker
FROM docker.io/library/node:18-alpine AS base

ARG BUILD_ENV
ENV BUILD_ENV=$BUILD_ENV

# Cache bust to prevent layer reuse between environments
ARG CACHE_BUST
RUN echo "Building with cache bust: ${CACHE_BUST}"

# Install pnpm globally
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN coreutils-env printf "Prefix: Installing pnpm..." && \
    npm install -g pnpm@latest && \
    pnpm --version

# Install dependencies only when needed
FROM base AS deps
# Install dependencies required for sharp (image processing)
RUN apk add --no-cache \
    libc6-compat \
    vips-dev \
    build-base \
    python3 \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/community \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/main

WORKDIR /app/next-app/

# Copy dependency files
COPY package.json pnpm-lock.yaml* ./

# Install dependencies with pnpm
# pnpm is 3x faster than npm (9.5s vs 28.6s for clean install)
# With cache: 749ms vs 1.3s
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm config set enable-pre-post-scripts true && \
    pnpm install --frozen-lockfile --prefer-offline --ignore-scripts && \
    cd node_modules/sharp && pnpm install --ignore-scripts=false || true

# Rebuild the source code only when needed
FROM base AS builder
RUN apk add --no-cache libc6-compat

WORKDIR /app/next-app/
# .env file is copied by build script into frontend folder before build
COPY .env /app/next-app/.env

################### SET IN THE SCRIPT BUILD COMMAND
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
###################

# Copy the node_modules directory from the deps stage
COPY --from=deps /app/next-app/node_modules ./node_modules
# Copy all frontend source files from build context
COPY . .

# Next.js collects completely anonymous telemetry data about general usage.
ENV NEXT_TELEMETRY_DISABLED=1

# Build with standalone output for optimized production bundle
RUN pnpm run build

# Production image, copy all the files and run next
FROM base AS runner
WORKDIR /app/next-app/

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 --ingroup root --shell /bin/sh nextjs \
    && adduser nextjs nodejs

# Copy standalone build output (minimal production bundle)
COPY --from=builder --chown=nextjs:nodejs /app/next-app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/next-app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/next-app/public ./public

# Install curl, ping and netcat for debugging
RUN apk add --no-cache iputils netcat-openbsd curl

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# server.js is created by next build from the standalone output
CMD ["node", "server.js"]
