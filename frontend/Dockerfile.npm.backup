#FROM node:18-alpine AS base
FROM docker.io/library/node:18-alpine AS base

ARG BUILD_ENV
ENV BUILD_ENV=$BUILD_ENV

# Cache bust to prevent layer reuse between environments
ARG CACHE_BUST
RUN echo "Building with cache bust: ${CACHE_BUST}"

# Install dependencies only when needed
FROM base AS deps
# Check https://github.com/nodejs/docker-node/tree/b4117f9333da4138b03a546ec926ef50a31506c3#nodealpine to understand why libc6-compat might be needed.
RUN apk add --no-cache libc6-compat
WORKDIR /app/next-app/

COPY package.json ./
# COPY yarn.lock* ./
COPY package-lock.json* ./

# Install dependencies - optimized for speed
# Official npmjs.org is fastest (tested: 0.129s vs 3.5s for mirrors)
# Cache is preserved between builds - packages download only once
RUN --mount=type=cache,target=/root/.npm \
    npm config set audit false && \
    npm config set fund false && \
    npm config set loglevel error && \
    npm config set progress false && \
    npm ci --no-audit --no-fund --prefer-offline && \
    npm install @next/swc-linux-x64-musl --no-audit --no-fund

# Rebuild the source code only when needed
FROM base AS builder
# libc6-compat needed for Next.js SWC binary
RUN apk add --no-cache libc6-compat

WORKDIR /app/next-app/
# .env file is copied by build script into frontend folder before build
COPY .env /app/next-app/.env

################### SET IN THE SCRIPT BUILD COMMAND
# Declare build-time arguments from the build command
# ARG PORT
# ARG NEXT_PUBLIC_BASE_PATH
# ARG BACKEND_URL
ARG NEXT_PUBLIC_API_URL

# Optionally set them as environment variables inside the container
# ENV PORT=${PORT}
# ENV NEXT_PUBLIC_BASE_PATH=${NEXT_PUBLIC_BASE_PATH}
# ENV BACKEND_URL=${BACKEND_URL}
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

# EXPOSE 3000  ❌ not needed
###################

# Copy the node_modules directory from the deps stage
COPY --from=deps /app/next-app/node_modules ./node_modules
# Copy all frontend source files from build context
COPY . .

# Copy the application source code needed for the build
COPY --from=deps /app/next-app/package.json ./package.json

# Next.js collects completely anonymous telemetry data about general usage.
# Learn more here: https://nextjs.org/telemetry
# Uncomment the following line to disable telemetry during the build.
ENV NEXT_TELEMETRY_DISABLED 1
# RUN yarn run build
RUN npm run build

# Production image, copy all the files and run next
FROM base AS runner
WORKDIR /app/next-app/

ENV NODE_ENV production
ENV NEXT_TELEMETRY_DISABLED 1
RUN addgroup --system --gid 1001 nodejs
#RUN adduser --system --uid 1001 nextjs
# Add the user nextjs with UID 1001, assign to the root group, and set the shell to /bin/bash
# Add the user to the nodejs group as well during user creation
RUN adduser --system --uid 1001 --ingroup root --shell /bin/sh nextjs \
    && adduser nextjs nodejs

# Cleaner needs testing
# RUN addgroup -g 1001 nodejs \
    # && adduser -u 1001 -G nodejs -s /bin/sh -D nextjs

# Modify /etc/hosts to resolve localhost to 127.0.0.1 instead of ::1
#RUN sed -i 's/^::1/#::1/' /etc/hosts

COPY --from=builder /app/next-app/public ./public
COPY --from=builder /app/next-app/.next ./.next

RUN mkdir -p .next/cache/images \
    && chown -R nextjs:nodejs .next

# Set the correct permission for prerender cache
# RUN mkdir .next
RUN chown nextjs:nodejs .next

# Automatically leverage output traces to reduce image size
# https://nextjs.org/docs/advanced-features/output-file-tracing
COPY --from=builder --chown=nextjs:nodejs /app/next-app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/next-app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/next-app/.next ./.next

# Install curl, ping and netcat
RUN apk add --no-cache iputils netcat-openbsd curl

# Install ping and netcat for debugging in the runner stage
# RUN apk update && apk add --no-cache iputils netcat-openbsd

# Install curl in an Alpine-based image
# RUN apk update && apk add --no-cache curl

USER nextjs

# server.js is created by next build from the standalone output
# https://nextjs.org/docs/pages/api-reference/next-config-js/output
CMD HOSTNAME="0.0.0.0" node server.js

